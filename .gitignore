# =========================
# Unity .gitignore
# =========================

# Unity generated folders (NOT needed in version control)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures (generated by Unity)
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# =========================
# Visual Studio / VS Code
# =========================
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.mdb

# =========================
# OS generated files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================
# Builds (keep them out of repo)
# =========================
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
*.so

# =========================
# Crash files
# =========================
crashlytics-build.properties
sysinfo.txt

# =========================
# PlasticSCM
# =========================
*.ignore
*.merge

# =========================
# mono crash
# =========================
*.pidb.meta

# =========================
# Never ignore meta files
# =========================
# !*.meta  <- meta files SHOULD be committed, this is just a reminder

# E2E 测试与构建产物
.e2e/
Builds/
/Build/
recordings/

# 字体修复脚本自动生成的场景备份（一次性产物，不该入库）
SceneBackup_手动/FontFixBackup/
